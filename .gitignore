# Credentials / secrets (never commit)
firebase/firebase-service-account.json
config.local.php

# PHP error logs (may contain paths / sensitive data)
error_log
*.log

# Backup / archive artifacts (source-disclosure risk)
*.bak
*.bak2
*.zip

# User-uploaded content & runtime session files (PII — must not be versioned).
# Contents are ignored, but each directory's protective .htaccess stays tracked.
/adhar/*
!/adhar/.htaccess
/kundli/*
!/kundli/.htaccess
/gallary/*
!/gallary/.htaccess
/success/*
!/success/.htaccess
/uploads/*
!/uploads/.htaccess
/sessions/*
!/sessions/.htaccess

# OS files
Thumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/
